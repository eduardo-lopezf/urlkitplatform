{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urlkit.example/schemas/criteria.json",
  "title": "Criteria",
  "description": "Versioned criteria of the v2 network tools (002 research R8). They are versioned with the rules catalog: adding a criterion is MINOR; changing a threshold, a list or a severity that already exists is MAJOR, because it changes the meaning of a result.",
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["source", "reviewed"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "headers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reviewed", "hsts", "csp", "frameOptions", "referrerPolicy"],
      "properties": {
        "source": { "$ref": "#/$defs/meta/properties/source" },
        "reviewed": { "$ref": "#/$defs/meta/properties/reviewed" },
        "hsts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minMaxAge"],
          "properties": { "minMaxAge": { "type": "integer", "minimum": 0 } }
        },
        "csp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unsafeScriptSources"],
          "properties": { "unsafeScriptSources": { "$ref": "#/$defs/stringList" } }
        },
        "frameOptions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid"],
          "properties": { "valid": { "$ref": "#/$defs/stringList" } }
        },
        "referrerPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "unsafe"],
          "properties": {
            "valid": { "$ref": "#/$defs/stringList" },
            "unsafe": { "$ref": "#/$defs/stringList" }
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reviewed", "expiringSoonDays", "weakSignatures", "legacyProtocols"],
      "properties": {
        "source": { "$ref": "#/$defs/meta/properties/source" },
        "reviewed": { "$ref": "#/$defs/meta/properties/reviewed" },
        "expiringSoonDays": { "type": "integer", "minimum": 1 },
        "weakSignatures": { "$ref": "#/$defs/stringList" },
        "legacyProtocols": { "$ref": "#/$defs/stringList" }
      }
    },
    "severities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reviewed", "severities"],
      "properties": {
        "source": { "$ref": "#/$defs/meta/properties/source" },
        "reviewed": { "$ref": "#/$defs/meta/properties/reviewed" },
        "severities": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
          "additionalProperties": { "enum": ["high", "medium", "low", "info"] }
        }
      }
    },
    "precedence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reviewed", "precedence"],
      "properties": {
        "source": { "$ref": "#/$defs/meta/properties/source" },
        "reviewed": { "$ref": "#/$defs/meta/properties/reviewed" },
        "precedence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description", "image", "url", "siteName", "type"],
          "patternProperties": {
            "^(title|description|image|url|siteName|type)$": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["openGraph", "twitter", "basic"] }
            }
          }
        }
      }
    }
  }
}
