---
/**
 * Common layout (T034): header, tool navigation, language switch that keeps the fragment.
 * No cookies and no third-party scripts (FR-002, FR-005). The CSP is generated by Astro.
 */
import '@urlkit/ui/tokens.css';
import { TOOL_IDS } from '@urlkit/core';
import { t, type Lang } from '@urlkit/i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Current tool, or the page slug (`''` for home, `about`, `api`). */
  page: string;
}

const { lang, title, description, page } = Astro.props;
const other: Lang = lang === 'es' ? 'en' : 'es';
const otherHref = `/${other}/${page ? `${page}` : ''}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="alternate" hreflang={other} href={otherHref} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">{t('ui.skip', lang)}</a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href={`/${lang}/`}>{t('ui.site.name', lang)}</a>
        <a class="lang uk-button" href={otherHref} hreflang={other} lang={other} data-keep-fragment
          >{t('ui.lang.other', lang)}</a
        >
      </div>
      <nav aria-label={t('ui.nav.label', lang)}>
        <ul>
          {
            TOOL_IDS.map((id) => (
              <li>
                <a href={`/${lang}/${id}`} aria-current={page === id ? 'page' : undefined}>
                  {t(`ui.tool.${id}.name`, lang)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer>
      <p class="uk-muted">{t('ui.footer', lang)}</p>
      <p class="uk-muted">
        <a href={`/${lang}/about`}>{t('ui.nav.about', lang)}</a> · <a href={`/${lang}/api`}>{t('ui.nav.api', lang)}</a>
      </p>
    </footer>
    <script>
      // The language switch keeps the shareable fragment (#u=…), which never reaches a server.
      for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-keep-fragment]')) {
        link.addEventListener('click', () => {
          if (location.hash) link.hash = location.hash;
        });
      }
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: var(--space-4);
    top: var(--space-2);
    z-index: 10;
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg);
  }
  .site-header,
  main,
  footer {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }
  .site-header {
    padding-top: var(--space-4);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }
  .brand {
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--color-text);
    text-decoration: none;
  }
  .site-header nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: var(--space-3) 0 0;
    padding: 0 0 var(--space-3);
    list-style: none;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }
  .site-header nav a[aria-current='page'] {
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }
  main {
    padding-top: var(--space-5);
    padding-bottom: var(--space-6);
  }
  main:focus {
    outline: none;
  }
  h1 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-xl);
    line-height: 1.2;
  }
  .lede {
    margin: 0 0 var(--space-5);
    color: var(--color-muted);
  }
  footer {
    padding-bottom: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
</style>
