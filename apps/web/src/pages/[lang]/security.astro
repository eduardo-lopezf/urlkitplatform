---
import { t, LANGS, type Lang } from '@urlkit/i18n';
import SecurityIsland from '../../islands/SecurityIsland.vue';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const name = t('ui.tool.security.name', lang);
const summary = t('ui.tool.security.summary', lang);
---

<Base lang={lang} page="security" title={`${name} · URLkit`} description={summary}>
  <h1>{name}</h1>
  <p class="lede">{summary}</p>
  <SecurityIsland client:load lang={lang} />
</Base>
