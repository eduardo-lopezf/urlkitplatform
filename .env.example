# Production variables for `docker compose --profile selfhosted up -d` on the VPS.
# Copy to `.env` next to docker-compose.yml and fill in. `.env` is ignored by git: never commit it.
# See infrastructure/README.md, "Despliegue autogestionado".

# Daily pseudonym key for quotas. 32+ characters; the API refuses to start without it.
# Generate it with: openssl rand -hex 32
QUOTA_SECRET=

# Password of the PostgreSQL that stores organizations, API key hashes and usage counts.
# Generate it with: openssl rand -hex 24. Compose builds the API's DATABASE_URL from it.
POSTGRES_PASSWORD=

# Only when the API runs outside Compose (pnpm dev): the database to use. With Compose it is set
# for you. Without it, API keys are disabled outside production; in production the API refuses to
# start.
# DATABASE_URL=postgres://urlkit:urlkit@localhost:5432/urlkit

# Development only: host port of PostgreSQL, if 5432 is taken by another project.
# POSTGRES_PORT=5432

# Public name of the API. Caddy requests its TLS certificate for this name.
API_DOMAIN=api.example.com

# Origin of the web (Cloudflare Pages), the only one allowed by CORS.
WEB_ORIGIN=https://example.com

# Optional. Error reporting with data scrubbing (research R8). Empty disables it.
# Empty at launch: enabling it requires its row in docs/privacidad.md first.
SENTRY_DSN=

# Optional. OTLP/HTTP endpoint for traces. Empty disables it.
# Empty at launch: enabling it requires its row in docs/privacidad.md first.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Not used by Compose: PUBLIC_API_URL is set in Cloudflare Pages at build time
# (https://<API_DOMAIN>), and also fixes the CSP connect-src of the web.
